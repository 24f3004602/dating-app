# --- secrets and local config (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore
credentials*.json
service-account*.json

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/

# --- Node / Expo / Next.js ---
node_modules/
.expo/
.next/
out/
dist/
build/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- tests ---
test-results/
playwright-report/
blob-report/
coverage/

# --- local media and data written by dev servers ---
var/
*.sqlite3
*.log

# --- Replica reference material: screenshots of other apps are research only
#     and must never be committed or shipped ---
replica/screens/
replica/clone-screens/
replica/diffs/

# --- OS / editors ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- owner handoff files (local only) ---
claude-code-handoff.md
dating-app.bundle

# --- e2e run artefacts ---
e2e/.run/

# Raw videos dropped in the project folder are never committed: stock licences limit
# redistributing them (stage 19). Web-ready files are added deliberately, by path.
/*.mp4
/*.mov
/*.webm
/*.mkv

# Impeccable (D100): the engine binary is downloaded and checksum-verified by its
# launcher, so it never goes into git.
.claude/skills/impeccable/scripts/bin/
# impeccable-ignore-start
# Ephemeral output, runtime state, and per-dev overrides.
# The **/ prefix covers .impeccable at the repo root or in a nested workspace.
# Shared artifacts stay tracked: config.json, live/config.json,
# design.json, surfaces/*.md, critique/*.md.
**/.impeccable/config.local.json
**/.impeccable/hook.cache.json
**/.impeccable/hook.pending.json
**/.impeccable/*.png
**/.impeccable/review/
**/.impeccable/questions/
**/.impeccable/live/server.json
**/.impeccable/live/sessions/
**/.impeccable/live/previews/
**/.impeccable/live/annotations/
**/.impeccable/live/cache/
**/.impeccable/live/manual-edit-apply-transaction.json
**/.impeccable/live/manual-edit-events.jsonl
**/.impeccable/live/manual-edit-evidence/
**/.impeccable/live/pending-manual-edits.json
**/.impeccable/live/deferred-svelte-component-accepts.json
**/.impeccable/live/*.png
# impeccable-ignore-end
