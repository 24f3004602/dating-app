# Copy to `.env` (gitignored) and fill in. No real values belong in this file.

# development | test | production
APP_ENV=development
BRAND_NAME=Haanji

# Runtime role: DML only. Its user name must equal DB_RUNTIME_ROLE.
DATABASE_URL=postgresql+psycopg://app_runtime:<runtime-password>@localhost:5432/datingapp
# Schema-owner role: used by Alembic (and by the test suite to create its own database).
MIGRATIONS_DATABASE_URL=postgresql+psycopg://app_owner:<owner-password>@localhost:5432/datingapp
DB_RUNTIME_ROLE=app_runtime

REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=INFO
LOG_JSON=true

# Tests only: database the suite drops and recreates (must end in _test).
# Defaults to <database>_test.
# TEST_DATABASE_NAME=datingapp_test

# scripts/bootstrap_db.py only (dev and CI): a superuser or CREATEROLE connection.
# BOOTSTRAP_ADMIN_URL=postgresql://postgres:<admin-password>@localhost:5432/postgres
