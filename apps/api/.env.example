# Copy to `.env` (gitignored) and fill in. No real values belong in this file.
# Every setting is listed (tests/test_env_example.py checks); commented lines
# show the default. Production refuses unsafe values (app/config.py).

# --- the app -----------------------------------------------------------------
# development | test | beta | production
# beta (D096): a small invite-only test on one server. Production's rules, except
# photos may stay on the server's disk and the documents may be "beta-" versions.
APP_ENV=development
BRAND_NAME=Haanji
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
LOG_JSON=true

# At least 32 random characters, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# It keys: one-time-code hashes, rate-limit keys, signed photo URLs, staff
# recovery codes, banned-email hashes, and the encryption of staff TOTP
# secrets. Rotating it voids live codes and photo links, resets rate limits,
# makes banned-email hashes useless and makes every staff member enrol their
# authenticator again (D090). Plan a rotation (deploy.md, runbooks).
APP_SECRET_KEY=<at-least-32-random-characters>

# --- database and Redis ----------------------------------------------------------
# Runtime role: DML only. Its user name must equal DB_RUNTIME_ROLE.
DATABASE_URL=postgresql+psycopg://app_runtime:<runtime-password>@localhost:5432/datingapp
# Schema-owner role: used by Alembic (and by the test suite to create its own database).
MIGRATIONS_DATABASE_URL=postgresql+psycopg://app_owner:<owner-password>@localhost:5432/datingapp
DB_RUNTIME_ROLE=app_runtime
# DB_POOL_SIZE=5
# DB_CONNECT_TIMEOUT_S=3.0
REDIS_URL=redis://localhost:6379/0
# REDIS_TIMEOUT_S=1.0
# Namespace for every Redis key and channel.
# RATE_LIMIT_PREFIX=rl
# READINESS_TIMEOUT_S=2.0

# --- HTTP ------------------------------------------------------------------------
# Exact browser origins (the Expo web build, the console's own origin is not needed:
# it calls the API from its server). https only in production. JSON list.
# CORS_ORIGINS=["http://localhost:8081"]
# Proxies whose X-Forwarded-For is believed: the load balancer and the console's
# server. Addresses or networks, never "*". Empty: the socket's address is used.
# TRUSTED_PROXIES=["10.0.0.0/16"]
# The public website's origin; waitlist emails link to it. https on a server.
# SITE_URL=http://localhost:3000
# MAX_REQUEST_BODY_BYTES=1048576
# MAX_UPLOAD_BODY_BYTES=11534336

# --- accounts and sessions --------------------------------------------------------
# rfc9106_low_memory (always in production) | test (cheap hashes for the test suite)
# PASSWORD_HASH_PROFILE=rfc9106_low_memory
# PASSWORD_MIN_LENGTH=15
# PASSWORD_MAX_LENGTH=128
# CODE_TTL_S=600
# CODE_MAX_ATTEMPTS=5
# SESSION_TTL_DAYS=30
# SESSION_TOUCH_INTERVAL_S=900
# LOGIN_LOCKOUT_THRESHOLD=100
# Versions members accept at sign-up. "draft-" versions are refused in beta and
# production; "beta-" versions (the beta tester notice) are refused in production.
TERMS_VERSION=draft-2026-11
PRIVACY_VERSION=draft-2026-11
# Invite-only sign-up (required in beta): `datingapp-api invite add <email>...`.
# SIGNUP_INVITE_ONLY=false
# INVITE_DAYS=30

# --- staff console (D090) -----------------------------------------------------------
# STAFF_SESSION_HOURS=12
# STAFF_IDLE_MINUTES=30
# STAFF_CHALLENGE_TTL_S=300
# STAFF_ENROLLMENT_HOURS=24

# --- email ---------------------------------------------------------------------------
# console (development: prints mail to stdout) | memory (tests) | smtp (any SMTP
# submission server, always over TLS). Beta and production need smtp.
EMAIL_BACKEND=console
# With Gmail, this must be the Gmail address itself.
EMAIL_FROM=no-reply@example.invalid
# Gmail: smtp.gmail.com, 587, starttls, the address and an app password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# starttls (port 587) | tls (port 465). There is no plaintext option.
# SMTP_SECURITY=starttls
# SMTP_USERNAME=<sender-address>
# SMTP_PASSWORD=<app-password>
# SMTP_TIMEOUT_S=15.0

# --- photos ----------------------------------------------------------------------------
# local (development and beta: the server's disk) | memory (tests). Production
# needs a private bucket (owner setup).
# STORAGE_BACKEND=local
# MEDIA_DIR=var/media
# MEDIA_URL_TTL_S=300
# PHOTO_REVIEW_REQUIRED=true
# PHOTO_MAX_BYTES=10485760
# PHOTO_MAX_PIXELS=40000000
# PHOTO_MIN_SIDE=300
# PHOTO_MAX_COUNT=6

# --- discovery, matching and messaging -------------------------------------------------------
# DISCOVERY_SET_SIZE=15
# DAILY_LIKE_LIMIT=10
# YOUR_TURN_CAP=5
# YOUR_TURN_WINDOW_DAYS=7
# REALTIME_TICKET_TTL_S=30
# REALTIME_HEARTBEAT_S=25.0
# REALTIME_REVALIDATE_S=120.0
# REALTIME_MAX_CONNECTIONS=5

# --- push notifications (D093) ------------------------------------------------------------
# none (default: nothing sent) | memory (tests) | expo (needs the owner's EAS project)
# PUSH_BACKEND=none
# Only if "enhanced push security" is on in the Expo dashboard.
# EXPO_ACCESS_TOKEN=<expo-access-token>

# --- payments, sandbox only (D094) -----------------------------------------------------------
# none (default: checkout refused) | fake (tests) | razorpay (test keys only)
# PAYMENTS_BACKEND=none
# RAZORPAY_KEY_ID=rzp_test_<id>
# RAZORPAY_KEY_SECRET=<key-secret>
# RAZORPAY_WEBHOOK_SECRET=<webhook-secret>
# RAZORPAY_PLAN_ID=plan_<id>
# Live keys (rzp_live_...) are refused unless this is true: the owner's authorization.
# PAYMENTS_LIVE=false

# --- tools, not the app ----------------------------------------------------------------------
# Tests only: database the suite drops and recreates (must end in _test).
# Defaults to <database>_test.
# TEST_DATABASE_NAME=datingapp_test
# scripts/bootstrap_db.py only (dev and CI): a superuser or CREATEROLE connection.
# BOOTSTRAP_ADMIN_URL=postgresql://postgres:<admin-password>@localhost:5432/postgres
