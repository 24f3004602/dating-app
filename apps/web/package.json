{
  "name": "@datingapp/web",
  "version": "0.1.0",
  "private": true,
  "description": "Landing page and the staff console (Next.js). The console calls the API from its server only; browsers never hold an API token.",
  "scripts": {
    "tokens": "node scripts/tokens-css.mjs",
    "dev": "npm run tokens && next dev -p 3000",
    "build": "npm run tokens && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "@react-three/rapier": "2.2.0",
    "next": "16.4.5",
    "postprocessing": "6.39.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@types/three": "0.187.0",
    "typescript": "~6.0.3"
  }
}
