# The web site and staff console (apps/web). Copy to `.env.local` (gitignored).
# Server-side only: nothing here is NEXT_PUBLIC_, so nothing reaches browsers.

# How this server reaches the API.
API_URL=http://127.0.0.1:8000
# The API origin browsers load signed photo URLs from (CSP img-src). Defaults to API_URL.
# API_PUBLIC_URL=https://api.example.in
# The brand shown on pages (a working name until the trademark check, brand.md).
# BRAND_NAME=Haanji
# With several console servers behind a load balancer: one shared key so server
# actions work on any of them (Next.js self-hosting guide). base64 of 32 random bytes.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=<base64-32-bytes>
